VITE_API_BASE_URL="http://localhost:3000"
# The bearer token this single-user instance expects. In prod, set this at
# build time via your host's env vars — it's fine to ship in the bundle
# since only you use this app, but keep the repo's .env out of git regardless.
VITE_API_TOKEN="change-me-to-a-long-random-value"
