{
  "name": "Hogarth Unlimited (Gutter)",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "cd backend && npm install && npx prisma generate && cd ../frontend && npm install",
  "forwardPorts": [3000, 5173],
  "portsAttributes": {
    "3000": { "label": "API (backend)", "onAutoForward": "notify" },
    "5173": { "label": "Web (frontend)", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "prisma.prisma",
        "bradlc.vscode-tailwindcss",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "remoteEnv": {
    "DATABASE_URL": "file:./dev.db"
  }
}
