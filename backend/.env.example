# Local dev: SQLite file. In production this points at a file on a mounted volume.
DATABASE_URL="file:./dev.db"

# Single-user bearer token. Generate with: openssl rand -hex 32
API_TOKEN="change-me-to-a-long-random-value"

# CORS: the origin your frontend is served from (Vite dev server, or your prod domain)
WEB_ORIGIN="http://localhost:5173"

PORT=3000

# S3-compatible object storage (Cloudflare R2, or any S3-compatible provider)
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="hogarth-unlimited"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public/CDN base URL if you put R2 behind a custom domain. Leave blank to use presigned URLs instead.
S3_PUBLIC_BASE_URL=""
